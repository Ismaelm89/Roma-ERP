# Roma ERP — production environment variables.
# Copy this file to `.env` on the server and fill in the real values.
# NEVER commit .env to git (it's in .gitignore).

# ---- The domain you'll access the app from ----
DOMAIN=app.example.com
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# ---- Django secret key ----
# Generate a fresh random key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

# ---- PostgreSQL credentials ----
# Pick a long random password — these are only used internally by docker-compose.
POSTGRES_DB=roma
POSTGRES_USER=roma
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_STRING

# ---- Let's Encrypt email (for cert expiry warnings) ----
LE_EMAIL=you@example.com

# ---- Toggles ----
DJANGO_DEBUG=False
DJANGO_SECURE_SSL_REDIRECT=True
