[Unit]
Description=Roma ERP — Telegram ops bot (locked-down Claude + MCP tools)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/roma-erp
EnvironmentFile=/opt/roma-erp/.env
ExecStart=/usr/bin/python3 /opt/roma-erp/deploy/ops_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
